# Build-time настройки фронтенда (vite build / pnpm dev)
PUBLIC_FALLBACK_PAGE=/200.html
PUBLIC_GOAT_COUNTER_URL=

# Хостовая директория с музыкой для Docker Compose:
# монтируется read-only в контейнер как /music. Отсутствие файлов в ней — не ошибка.
# Значение по умолчанию в docker-compose.yml — /data/music.
# Для локального запуска без Docker экспортируйте MUSIC_DIR с абсолютным путём (см. README).
MUSIC_DIR=/data/music

# Порт плеера в общей network namespace Yggdrasil (Docker Compose)
# Открывается на IPv6-адресе Yggdrasil; отдельная публикация host port не используется.
SNAE_PORT=3000

# --- Multiuser auth и серверное состояние (CONTRACTS.md §8–§10) ---

# Разрешить регистрацию новых аккаунтов. После создания нужных аккаунтов
# рекомендуется установить false.
SNAE_ALLOW_REGISTRATION=true

# Выставлять сессионный cookie с атрибутом Secure. Включайте только если сервис
# доступен по HTTPS! Текущий режим Yggdrasil — обычный HTTP: cookie передаётся
# открыто и сессия может быть перехвачена (см. предупреждение в README),
# поэтому по умолчанию false.
SNAE_SECURE_COOKIES=false

# Доверять заголовку x-forwarded-proto (определение HTTPS) от reverse proxy.
# Включайте только если приложение стоит за доверенным proxy, иначе клиент
# может подделать заголовок.
SNAE_TRUST_PROXY=false

# Параллелизм серверного сканирования музыкальной библиотеки (1–16).
SNAE_SCAN_CONCURRENCY=4

# Постоянные данные (аккаунты, пользовательское состояние, музыкальный индекс)
# хранятся в DATA_DIR: в Docker это всегда /data (named volume snae-data,
# переопределять не нужно), локально по умолчанию ./.data.
# DATA_DIR не должен находиться внутри MUSIC_DIR.
# DATA_DIR=./.data
